pkgname=gamepad-desktop-dev
pkgver=0.0.1
pkgrel=2
pkgdesc='Desktop Client for the Mobile GamePad virtual controller'

arch=('x86_64')
options=('!strip')
license=('custom')
depends=(
	'glibc' 
	'gtk3'
)

url="https://github.com/neiderGainza/gamepad_releases"
source=("$url/raw/dev/gamepad_desktop/gamepad-desktop-client-dev-0.0.1-x86_64.tar.gz")
sha256sums=('a4de6369cdc2c4267d17fea9cbe3707e7a0a7432c8d716d0b45c4d0a60e9283b')

package() {
	install -dm755 "$pkgdir/opt/$pkgname"
	cp -a bundle/. "$pkgdir/opt/$pkgname/"
	chmod 755 "$pkgdir/opt/$pkgname/desktop"

	install -Dm644 \
		"$pkgdir/opt/$pkgname/data/flutter_assets/assets/icons/icon.png" \
		"$pkgdir/usr/share/icons/hicolor/256x256/apps/$pkgname.png"

	install -dm755 "$pkgdir/usr/share/applications"
	cat > "$pkgdir/usr/share/applications/$pkgname.desktop" <<EOF
[Desktop Entry]
Name=GamePad Desktop
Comment=Desktop client for the Mobile GamePad virtual controller
Exec=/opt/$pkgname/desktop
TryExec=/opt/$pkgname/desktop
Icon=$pkgname
Terminal=false
Type=Application
Categories=Game;
Keywords=gamepad;controller;remote;
EOF
}
